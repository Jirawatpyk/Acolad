# ===== XTM Acolad Portal (เป้าหมายหลักของ 002) =====
# หน้า login ของ XTM (host ยืนยันจาก recon D1: xtm.acolad.com/project-manager-gui)
XTM_ACOLAD_PORTAL_URL=https://xtm.acolad.com/project-manager-gui/login.jsp?client=YOUR-COMPANY
# มุมมอง Active (my-inbox) ที่เฝ้า — ยืนยันจาก recon D1
XTM_ACOLAD_OFFERS_URL=https://xtm.acolad.com/project-manager-gui/my-inbox-pages.action
# มุมมอง Closed — targeted check ตอนงาน accepted หาย (Closed vs Removed, FR-014); ยืนยัน recon D8
XTM_ACOLAD_CLOSED_URL=https://xtm.acolad.com/project-manager-gui/my-inbox-closed-tasks-page.action
# ข้อมูล login บัญชีแชร์ — ทั้งสามค่าเป็น secret (อยู่ใน redaction list); ใส่ค่าจริงใน .env เท่านั้น
XTM_ACOLAD_Company=YOUR-COMPANY
XTM_ACOLAD_Username=your-username
XTM_ACOLAD_Password=your-xtm-password

# ===== Google Chat Webhooks =====
# ช่องแจ้งเตือนระบบ (งานใหม่ + ผลกดรับ + ปัญหาระบบ + heartbeat alert) — จำเป็น
GOOGLE_CHAT_WEBHOOK_SYSTEM=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=XXXX&token=XXXX
# Team space webhook — daily report + accepted-job announcements (required, secret)
GOOGLE_CHAT_WEBHOOK_TEAM=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=XXXX&token=XXXX
# ช่องรายงานประจำวัน — [deprecated: ใช้ GOOGLE_CHAT_WEBHOOK_TEAM แทน] สงวนไว้สำหรับ backward compat ปล่อยว่างได้
GOOGLE_CHAT_WEBHOOK_DAILY_REPORT=

# ===== Google Sheets (บันทึกทุกงาน — 002 จำเป็น) =====
# id จาก URL ชีต (https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_ID=
# service account key (gitignored) — ค่า default = google-credentials.json
# ⚠️ บอท Straker อ่าน "ตัวเดียวกับ" ตัวนี้ (เพิ่ม 2026-09-16) ด้วยเหตุผลเดียวกับ
# GOOGLE_CHAT_WEBHOOK_SYSTEM: เครื่องเดียว service account เดียว key ไฟล์เดียว. การให้สองบอท
# ชี้คนละไฟล์ได้คือช่องทางพัง ไม่ใช่ความสามารถ จึงไม่มี STRAKER_SHEETS_KEY_PATH แยก
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=google-credentials.json
# ชื่อ tab เป้าหมาย (map จาก gid ตอน recon D7)
SHEETS_TAB_NAME=Tasks

# ===== Accept control (กดรับงานอัตโนมัติ) =====
# kill-switch (FR-012): 0 = ตรวจจับ+log+แจ้ง แต่ "ไม่กดรับ"; ตั้งต้น OFF เพื่อความปลอดภัย
# เปิด 1 หลัง recon ยืนยัน accept flow จริงแล้วเท่านั้น
ACCEPT_ENABLED=0
# evidence-only recon (FR-011/D6): 1 = เมื่อเจองานมาเลย์ (ตอน ACCEPT_ENABLED=0) ให้
# เปิดเมนู accept เก็บ DOM จริง (hover only ไม่กดรับ) เพื่อยืนยันสัญญาณ "Accept task" vs
# "Finish task" แล้วคำนวณ acceptAvailable; ส่ง Chat แจ้งครั้งเดียว. ปลอดภัยเปิดทิ้งไว้
ACCEPT_RECON=0
# รายการ target language ที่ eligible (csv) — config-driven (R8)
ACCEPT_LANGUAGES=Malay (Malaysia)
# เพดานคำต่องานที่กดรับอัตโนมัติ (FR-025); 0 = ไม่จำกัด
ACCEPT_MAX_WORDS=0
# เพดานจำนวนกดรับต่อรอบ (FR-025); 0 = ไม่จำกัด
ACCEPT_MAX_PER_CYCLE=0

# --- Auto-yield: back off when a human/another session uses the shared XTM account ---
# The bot and the team share ONE XTM login that allows only one session at a time.
# When the bot detects it was logged off by another user it yields instead of
# re-logging in (which would kick the human). Set to 0 to disable (e.g. once the
# bot has its OWN XTM account).
XTM_YIELD_ENABLED=1
# Cooldown between yield re-probes AND the "recently authenticated" threshold.
# MUST be >= 3 x POLL_INTERVAL_MS or the bot refuses to start.
XTM_YIELD_WINDOW_MS=600000
# Hard cap: if the bot stays yielded this long it raises a critical alert and pages
# on-call (a teammate may have left a session open, or XTM may be stuck).
XTM_YIELD_MAX_MINUTES=60

# ===== Heartbeat (Healthchecks.io dead-man switch) =====
# จำเป็น — สร้าง check (period 5 นาที, grace ≤ 10 นาที ตาม Constitution IV) แล้ววาง ping URL
# ⚠️ ค่านี้เป็น secret: ใครได้ URL ไปสามารถ ping ปลอมทำให้ระบบเฝ้าระวังไม่แจ้งเตือน
HEALTHCHECKS_PING_URL=

# ===== Tuning (optional — ค่า default ตาม contracts/config.md) =====
# รอบตรวจปกติ ms (zod บังคับ 20000-25000); 002 = 20000 (ปลายเร็วสุด ชนะหน้าต่าง < 1 นาที, R7)
#POLL_INTERVAL_MS=20000
# พอร์ต lock กันรันซ้อน (bind 127.0.0.1:<พอร์ต>) — ตัวที่สองจะ refuse.
# ⚠️ ถ้าแก้ค่านี้ ต้องแก้ $Port ใน scripts/deploy.ps1 ให้ตรงกันด้วย (deploy ไม่อ่าน .env)
#SINGLE_INSTANCE_PORT=47811
# จำนวน login ล้มเหลวก่อน lockout + alert
#LOGIN_MAX_RETRY=3
# ระยะหยุดพยายาม login (นาที)
#LOGIN_LOCKOUT_MINUTES=15
# รอบ recycle browser กัน memory leak (ชั่วโมง)
#BROWSER_RECYCLE_HOURS=6
# ที่เก็บ JSON logs (rotate 14 วัน)
#LOG_DIR=logs
# ที่เก็บ SQLite + storageState + evidence
#STATE_DIR=state
# เขตเวลาแสดงผล
#TZ_DISPLAY=Asia/Bangkok
# จำนวน retry สูงสุดต่อรายการแจ้งเตือนก่อนเปลี่ยนเป็น dead (FR-018)
#OUTBOX_RETRY_CAP=10
# อายุสูงสุด (ชม.) ของรายการค้างส่งก่อนเปลี่ยนเป็น dead (FR-018)
#OUTBOX_DEAD_AFTER_HOURS=6
# ตั้งเป็น 1 เพื่อเปิด live smoke test / recon กับ portal จริง (ห้ามใช้ใน CI)
#LIVE_PORTAL=

# --- Auto-accept scheduling (working-hours feasibility + daily word cap) ---
ACCEPT_SCHEDULE_ENABLED=1            # 0/false/off/no disables (then today's behavior)
ACCEPT_HOURS_START=09:00             # working-window start (Bangkok)
ACCEPT_HOURS_END=18:00               # working-window end (exclusive)
ACCEPT_WORKDAYS=1-5                  # ISO weekdays Mon=1..Sun=7 (ranges/lists)
ACCEPT_MAX_WORDS_PER_DAY=1000        # daily word budget (โหมด words); the primary knob; ต้อง > 0 เมื่อ gate เปิด (0 = fail-fast ตอน start); อยาก uncapped ให้ปิด gate: ACCEPT_SCHEDULE_ENABLED=0
ACCEPT_THROUGHPUT_WORDS_PER_HOUR=    # empty = derived (capacity ÷ working-hours/day ≈ 111); set to pin
ACCEPT_EFFORT_METRIC=wwc             # wwc = cap/throughput วัดด้วย File WWC (Weighted Word Count หลังหัก TM, ค่า default); words = พฤติกรรมเดิม byte-for-byte
ACCEPT_MAX_WWC_PER_DAY=1000          # daily WWC budget (โหมด wwc); WWC ≤ words → 1000 WWC/วัน คือ งานจริงมากกว่า 1000 words; ปรับให้ตรง capacity ทีม; ต้อง > 0 เมื่อ gate เปิด (0 = fail-fast ตอน start); อยาก uncapped ให้ปิด gate: ACCEPT_SCHEDULE_ENABLED=0
ACCEPT_THROUGHPUT_WWC_PER_HOUR=      # empty = derived (ACCEPT_MAX_WWC_PER_DAY ÷ ชม.ทำงาน/วัน); โหมด wwc เท่านั้น (ACCEPT_THROUGHPUT_WORDS_PER_HOUR ใช้เฉพาะโหมด words)

# --- Straker Phase 0 recon probe (read-only; `npm run straker:recon`) -------------
# Used ONLY by the probe in src/straker/. The live XTM bot does not read these and
# starts fine without them.
STRAKER_BASE_URL=https://vendr.arbitr.ai
STRAKER_LOGIN_ID=
STRAKER_PASSWORD=
# Only once Straker's 2FA is switched on (it is off today); leave blank until then.
# ปล่อยว่างได้จริง: ทั้งสอง loader ของ Straker อ่าน `KEY=` ว่า "ไม่ได้ตั้ง" (ดูหมายเหตุ "ค่าว่าง" ในบล็อกบอทด้านล่าง)
STRAKER_TOTP_CODE=
# 10s = 6 req/min = 2% of the 300 req/min budget measured during recon. Floor is 1000.
STRAKER_POLL_INTERVAL_MS=10000
STRAKER_CAPTURE_DIR=fixtures/straker

# --- JobCatch Straker bot (003; PM2 app `jobcatch-straker` / straker.config.cjs) --------
# อ่านโดย src/straker/config.ts (loadStrakerBotConfig) เท่านั้น — บอท XTM ไม่อ่านค่ากลุ่มนี้
# และ start ได้ตามปกติแม้ไม่ได้ตั้งเลย. ตัวที่ "ไม่มี default" = required (บอท Straker fail-fast
# ตอน start พร้อมชื่อ var ที่ผิด); ตัวที่มี default ปล่อยว่าง/คอมเมนต์ทิ้งไว้ได้
#
# หมายเหตุ "ค่าว่าง" (สำคัญ อ่านก่อนกรอก): `KEY=` ที่ไม่มีค่า = "ไม่ได้ตั้ง" สำหรับทั้งสอง loader ของ
# Straker (stripBlanks ใน src/straker/config.ts ตัดค่าว่างทิ้งก่อนเข้า zod) ดังนั้นทุกบรรทัดในไฟล์นี้
# ที่เขียนว่า "ว่าง = derived" หรือ "ปล่อยว่างไว้ก่อน" ทำงานตามที่เขียนจริง — ตัวที่มี default จะได้
# default, ตัว optional จะถือว่าไม่ได้ตั้ง. และตัวที่ required ถ้าปล่อยว่างจะ fail-fast ตอน start โดย
# บอกชื่อตัวเองว่า "Required" (ไม่ใช่ error แปลกๆ แบบตัวเลขผิดชนิด)
#
# STRAKER_BASE_URL / _LOGIN_ID / _PASSWORD / _TOTP_CODE / _POLL_INTERVAL_MS ประกาศไว้ในบล็อก
# recon probe ด้านบนแล้ว — บอทอ่านตัวเดียวกัน ห้ามประกาศซ้ำที่นี่ (ค่าท้ายสุดชนะแบบเงียบๆ)
# ⚠️ _POLL_INTERVAL_MS: 10s คือจังหวะของ probe; จังหวะ "แข่งคว้างาน" ของบอทตั้งจาก offer
# lifetime ที่วัดได้จริงหลัง probe จบ (SC-000/U2) และ probe ต้องถูกหยุดก่อนบอทเริ่ม (RP-5)
# จึงไม่มีสองโปรเซสยิง request แย่ง budget ก้อนเดียวกัน

# เพดานงานต่อวันของ Straker เอง (FR-009) — required, ไม่มี default โดยตั้งใจ: เพดานที่โค้ด
# เดาให้ = คำสัญญาที่ไม่มีใครเป็นคนให้ไว้. เป็น ledger คนละตัวกับ ACCEPT_MAX_*_PER_DAY ของ XTM
# (สองบอทรวมกันจึงเกิน capacity จริงได้ — ดูยอดรวมใน daily report แล้วลดเพดานเอง ไม่มีตัวบังคับ)
# ⚠️ บรรทัดนี้ "ตั้งใจ" ส่งมาเป็นค่าว่าง ไม่ใช่ลืมกรอก: ตัวเลขเพดานจริงยังไม่มีใครรู้จนกว่า capture
# probe จะจบ (plan §Unresolved U4 = จำนวนงาน/วัน + การกระจายขนาดงาน → ตัวเลขเพดาน; plan
# §Release configuration). ระหว่างนี้บอท Straker จะ fail-fast ตอน start ด้วยข้อความ
# "Straker bot config invalid — STRAKER_MAX_WORDS_PER_DAY: Required" ซึ่งเป็นพฤติกรรมที่ต้องการ:
# ยังไม่มีหลักฐาน = ยังไม่ควรมีบอทตัวนี้รับงานจริง. ห้ามเดาตัวเลขใส่เพื่อให้ start ผ่าน — เติมค่าจาก
# หลักฐานของ probe (แล้วบอทจะ start ได้เองทันที ไม่ต้องแก้โค้ด)
STRAKER_MAX_WORDS_PER_DAY=
# ว่าง = derived (STRAKER_MAX_WORDS_PER_DAY ÷ ชม.ทำงาน/วัน) สูตรเดียวกับ XTM; ใส่ค่าเพื่อ pin
# ให้ตรงคู่ภาษาที่ทีมทำช้าที่สุด (ค่าเฉลี่ยข้าม 44 คู่ภาษาไม่ใช่ตัวเลขที่ซื่อสัตย์)
STRAKER_THROUGHPUT_WORDS_PER_HOUR=

# เพดานงาน DTP (monolingual) ต่อวัน — **required เช่นกัน** ไม่มี default (เพิ่ม 2026-09-17).
# งาน DTP คืองานที่พอร์ทัลส่ง target_lang: null มา และรายงานเป็น `ja>ja` ฝั่งงานที่รับแล้ว
# นับเป็น "คำ" เหมือนกัน แต่ **คนละคำกัน**: หนึ่งคำของการจัดหน้าไม่ใช่หนึ่งคำของการแปล จึงมี
# ledger แยก เพดานแยก — ถ้าใช้เพดานเดียวกัน เช้าที่จัดหน้าจะไปกินโควตาบ่ายที่ต้องแปล
# ⚠️ ยังไม่มีใครวัดว่าทีมทำ DTP ได้กี่คำ/ชั่วโมงจริง (เห็นงานจริงมาแล้ว 1 งาน = 956 คำ) —
# ตัวเลขนี้จึงเป็นค่าที่เจ้าของตั้ง ไม่ใช่ค่าที่วัดมา ดู plan.md §Complexity Tracking
STRAKER_DTP_MAX_WORDS_PER_DAY=
# ว่าง = derived (STRAKER_DTP_MAX_WORDS_PER_DAY ÷ ชม.ทำงาน/วัน) — **ปล่อยว่างไว้**
# ใส่ค่าที่นี่ = แยกปุ่มออกเป็นสองปุ่มที่หลุดจากกัน: แก้เพดานแล้วเรตจะค้างที่ค่าเดิม
# จนกว่าจะมีใครนึกได้ว่าต้องมาแก้ตรงนี้ด้วย (บทเรียนเดียวกับ ACCEPT_THROUGHPUT_* ของ XTM)
STRAKER_DTP_THROUGHPUT_WORDS_PER_HOUR=

# --- isolation จากบอท XTM (FR-024) — ห้ามชนกันเด็ดขาด ---
# lock port ของ Straker (XTM ถือ 47811); zod ปฏิเสธค่า 47811 ตั้งแต่ตอน start
# ⚠️ ถ้าแก้ค่านี้ ต้องแก้ตาราง $Bots ใน scripts/deploy.ps1 ให้ตรงกันด้วย (deploy ไม่อ่าน .env)
STRAKER_SINGLE_INSTANCE_PORT=47812
# SQLite + state ของ Straker แยกโฟลเดอร์จาก STATE_DIR ของ XTM; zod ปฏิเสธค่า `state`
# (สองโปรเซสเปิดไฟล์ SQLite เดียวกัน = corruption ไม่ใช่ error จึงกันตั้งแต่ชั้น config)
STRAKER_STATE_DIR=state/straker
# โฟลเดอร์ log ใช้ร่วมกับ XTM ได้ — คนละไฟล์ (logs/jobcatch-straker.*.log + PM2 out/err ของตัวเอง)
# ⚠️ ถ้าแก้ค่านี้ (เช่น logs/straker) ต้องแก้ LogGlob ของ straker ในตาราง $Bots ของ scripts/deploy.ps1
# ให้ตรงกันด้วย — deploy ไม่อ่าน .env เหมือนกับ lock port ด้านบน. ไม่แก้ = deploy ที่สุขภาพดีจะ FAIL
# ที่ขั้น "5/5 verify" (หาไฟล์ log ไม่เจอ) แล้วชวนให้ไปกด pm2 restart มือ ซึ่งคือสิ่งที่สคริปต์นี้มีไว้กัน
STRAKER_LOG_DIR=logs

# --- reporting: ชีตของตัวเอง + ห้องประกาศงานของตัวเอง (FR-014, FR-015) ---
# id ชีตแยกจาก GOOGLE_SHEETS_ID ของ XTM (ใช้ service account เดิมได้ — google-credentials.json)
STRAKER_SHEETS_ID=
STRAKER_SHEETS_TAB_NAME=Straker_Tracking
# ห้องประกาศ "งานที่คว้ามาได้" ของ Straker — แยกจากห้องทีมของ XTM เพราะคนเลือกตามงานที่ตัวเองทำ
# ⚠️ secret (อยู่ใน redaction list)
STRAKER_CHAT_WEBHOOK_OFFERS=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=XXXX&token=XXXX
# ⚠️ GOOGLE_CHAT_WEBHOOK_SYSTEM (ประกาศไว้ด้านบนแล้ว) บอท Straker อ่าน "ตัวเดียวกับ" บอท XTM
# โดยตั้งใจ (FR-026b): alert ของทั้งสองบอทลงห้อง ops ห้องเดียว เพราะ on-call เฝ้าอยู่ที่เดียว —
# alert ที่ส่งไปที่ที่ไม่มีใครดู มีค่าเท่ากับไม่ได้ส่ง. การอ่านตัวแปรร่วมกันคือสิ่งที่กันไม่ให้สองบอท
# หลุดไปคนละปลายทาง จึง "ห้าม" เพิ่ม STRAKER_CHAT_WEBHOOK_SYSTEM แยก. แยกเฉพาะข่าวงาน
# ไม่แยก alert — ความไม่สมมาตรนี้ตั้งใจ ห้ามไล่ให้ "เหมือนกัน" ทั้งสองทาง

# --- liveness signal ของตัวเอง (FR-026a) ---
# Healthchecks check คนละตัวกับ HEALTHCHECKS_PING_URL ของ XTM — บอทไหนหยุดต้องรู้แยกกัน
# ไม่งั้นบอทที่ยังวิ่งอยู่จะบังการตายของอีกตัว. ⚠️ secret (ใครได้ URL ไปก็ ping ปลอมได้)
STRAKER_HEALTHCHECKS_PING_URL=

# --- ก่อนเปิดบอท Straker ครั้งแรก: สี่ค่าที่ "ไม่มี default" เพราะเดาแทนไม่ได้ ---
# STRAKER_MAX_WORDS_PER_DAY   เพดานที่โค้ดเดาให้ = คำมั่นที่ไม่มีใครให้ไว้ (XTM ใช้ 3500)
# STRAKER_SHEETS_ID           ต้องเป็นไฟล์ชีตคนละไฟล์กับ XTM (FR-014) — สร้างใหม่
# STRAKER_CHAT_WEBHOOK_OFFERS ห้องประกาศงานของ Straker เอง — สร้าง webhook ใหม่
# STRAKER_HEALTHCHECKS_PING_URL  check คนละตัวกับ XTM (FR-026a) — period 60s / grace 300s
# ขาดตัวใดตัวหนึ่ง = บอทไม่ start และบอกชื่อ var ที่ขาด ซึ่งเป็นพฤติกรรมที่ต้องการ
#
# และก่อนปล่อยจริง ยังมี release preconditions ที่ไม่ใช่ค่า config — ดู
# specs/003-straker-offer-race/release-preconditions.md. RP-4 (ยืนยัน lost-race signal ด้วย
# claim จริงหนึ่งครั้งใต้การดูแล) กั้นข้อเดาสี่ข้อในเส้นทาง claim อยู่ รวมถึง "due_at เป็น
# Bangkok หรือ NZ" ซึ่งถ้าเดาผิดจะผิดไปทางรับงานเกินกำลัง ไม่ใช่รับน้อยไป

# --- eligibility (FR-011) ---
# csv คู่ภาษาที่ "ไม่รับ" (เทียบแบบ lower-case) เช่น en-ms,en-th; ว่าง = รับครบทุกคู่ที่ลงทะเบียน
# ไว้ ซึ่งเป็นพฤติกรรมที่ตกลงกัน. มีไว้ให้ปิดคู่ภาษาที่ไม่มีคนทำด้วยการแก้ค่า + restart ไม่ต้อง release
STRAKER_EXCLUDED_LANGUAGE_PAIRS=

# --- ตารางเวลาของทีม: ใช้ร่วมกับบอท XTM โดยตั้งใจ (ไม่มี var ใหม่ให้ตั้ง) ---
# ACCEPT_HOURS_START / ACCEPT_HOURS_END / ACCEPT_WORKDAYS (ประกาศไว้ด้านบนแล้ว) ถูกอ่านซ้ำโดย
# บอท Straker ตรงๆ: เวลาทำงาน วันทำงาน และปฏิทินวันหยุด เป็นของทีมชุดเดียวกัน — มีแค่ ceiling
# กับ throughput ที่เป็นของ Straker เอง. ถ้าทำ copy แยก (เช่น STRAKER_HOURS_*) สองบอทจะเข้าใจ
# "เวลาทำงานของทีม" ไม่ตรงกันได้ ซึ่งไม่มีใครตั้งใจให้เกิด จึงไม่มี และห้ามเพิ่ม
